# Copy to backend.tf and fill in your own bucket. Create the bucket first
# (versioning + encryption enabled). Native S3 locking needs Terraform >= 1.10.
terraform {
  backend "s3" {
    bucket       = "YOUR-TFSTATE-BUCKET"
    key          = "eks-fargate-landing-zone/dev/terraform.tfstate"
    region       = "eu-west-1"
    encrypt      = true
    use_lockfile = true
  }
}
